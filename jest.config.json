{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s"
  ],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "transformIgnorePatterns": [
    "<rootDir>/../node_modules/(?!(node-fetch|data-uri-to-buffer|fetch-blob|formdata-poly-fill|https-proxy-agent|agent-base|proxy-agent-negotiate)/)"
  ]
}